#!/usr/bin/env python3
"""mergehex: merge Intel HEX files — Linux replacement for Nordic's mergehex.exe.

Usage: mergehex -m a.hex b.hex [...] -o out.hex
Later files take precedence on overlapping addresses.
Requires the `intelhex` package (provided by the flake devShell).
"""
import sys

from intelhex import IntelHex


def main() -> int:
    args = sys.argv[1:]
    inputs, output = [], None
    i = 0
    while i < len(args):
        if args[i] == "-m":
            while i + 1 < len(args) and not args[i + 1].startswith("-"):
                inputs.append(args[i + 1])
                i += 1
        elif args[i] == "-o":
            output = args[i + 1]
            i += 1
        i += 1

    if not inputs or not output:
        sys.stderr.write(__doc__)
        return 1

    merged = IntelHex()
    for path in inputs:
        merged.merge(IntelHex(path), overlap="replace")
    merged.write_hex_file(output)
    return 0


if __name__ == "__main__":
    sys.exit(main())
